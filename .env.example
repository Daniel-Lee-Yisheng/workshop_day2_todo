# Copy to .env.local and fill in.

# Secret used to sign session JWTs (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# SQLite file location (defaults to data/todos.db)
DATABASE_PATH=data/todos.db

# WebAuthn relying party (defaults are fine for local dev)
RP_ID=localhost
RP_NAME=Todo App
ORIGIN=http://localhost:3000
